@@ -0,0 +1,57 @@
+package main
+
+import (
+	"context"
+	"testing"
+
+	"github.com/spf13/cobra"
+	"github.com/steveyegge/beads/internal/storage"
+)
+
+func TestUpdateVersionGuardPreservesWireToken(t *testing.T) {
+	for _, token := range []string{"0", "-9223372036854775808", "9223372036854775807"} {
+		t.Run(token, func(t *testing.T) {
+			cmd := &cobra.Command{}
+			cmd.Flags().String("if-version", "", "")
+			if err := cmd.Flags().Set("if-version", token); err != nil {
+				t.Fatal(err)
+			}
+			version, err := updateVersionGuardFromFlags(cmd, true)
+			if err != nil {
+				t.Fatal(err)
+			}
+			updater := &recordingDirectIssueUpdater{}
+			_, err = runCommandUpdateMutation(context.Background(), updater, commandUpdateMutation{expectedVersion: version})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if updater.requests[0].ExpectedVersion == nil || *updater.requests[0].ExpectedVersion != *version {
+				t.Fatal("command dropped or rounded the revision guard")
+			}
+		})
+	}
+	if !isGuardMismatch(storage.ErrVersionMismatch) {
+		t.Fatal("version mismatch must exit as a refused guard")
+	}
+}
+
+func TestUpdateVersionGuardRefusesInvalidOrGraphOnly(t *testing.T) {
+	for _, token := range []string{"", "not-a-token", "9223372036854775808"} {
+		cmd := &cobra.Command{}
+		cmd.Flags().String("if-version", "", "")
+		if err := cmd.Flags().Set("if-version", token); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := updateVersionGuardFromFlags(cmd, true); err == nil {
+			t.Fatalf("accepted %q", token)
+		}
+	}
+	cmd := &cobra.Command{}
+	cmd.Flags().String("if-version", "", "")
+	if err := cmd.Flags().Set("if-version", "0"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := updateVersionGuardFromFlags(cmd, false); err == nil {
+		t.Fatal("accepted an unguarded graph-only mutation")
+	}
+}
