+// This crosses the CLI/persistence boundary: replacing only the question must
+// invalidate a previously read revision while status and assignee still match.
+func TestUpdateIfVersionCLI(t *testing.T) {
+	if os.Getenv("BEADS_TEST_EMBEDDED_DOLT") != "1" {
+		t.Skip("set BEADS_TEST_EMBEDDED_DOLT=1 to run embedded dolt integration tests")
+	}
+	bd := buildEmbeddedBD(t)
+	dir, _, _ := bdInit(t, bd, "--prefix", "uv")
+	issue := bdCreate(t, bd, dir, "Operator question", "--notes", "hold: first question")
+	readRevision := func() string {
+		t.Helper()
+		cmd := exec.Command(bd, "show", issue.ID, "--json")
+		cmd.Dir, cmd.Env = dir, bdEnv(dir)
+		out, err := cmd.Output()
+		if err != nil {
+			t.Fatal(err)
+		}
+		var details []types.IssueDetails
+		if err := json.Unmarshal(out, &details); err != nil {
+			t.Fatal(err)
+		}
+		if len(details) != 1 || details[0].Revision == "" {
+			t.Fatalf("missing revision: %s", out)
+		}
+		return details[0].Revision
+	}
+	old := readRevision()
+	bdUpdate(t, bd, dir, issue.ID, "--notes", "hold: replacement question")
+	fresh := readRevision()
+	if old == fresh {
+		t.Fatal("a notes-only write did not invalidate the revision")
+	}
+	out, code := bdUpdateFailCode(t, bd, dir, issue.ID, "--if-version", old,
+		"--if-status", "open", "--if-assignee", "", "--status", "closed", "--append-notes", "release: old answer")
+	if code != ExitGuardMismatch {
+		t.Fatalf("stale revision exit %d: %s", code, out)
+	}
+	got := bdShow(t, bd, dir, issue.ID)
+	if got.Status != types.StatusOpen || got.Notes != "hold: replacement question" {
+		t.Fatalf("stale answer changed replacement: %#v", got)
+	}
+	bdUpdate(t, bd, dir, issue.ID, "--if-version", fresh, "--append-notes", "release: approved replacement")
+	if got := bdShow(t, bd, dir, issue.ID); got.Notes != "hold: replacement question\nrelease: approved replacement" {
+		t.Fatalf("matching revision failed: %q", got.Notes)
+	}
+}
