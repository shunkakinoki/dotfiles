{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/config/shared/hooks/security.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "$HOME/dotfiles/config/shared/hooks/block-git-identity.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
