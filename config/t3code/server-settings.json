{
  "providers": {
    "claudeAgent": {
      "enabled": true
    },
    "codex": {
      "enabled": true
    }
  },
  "providerInstances": {
    "claude-cliproxy": {
      "driver": "claudeAgent",
      "displayName": "Claude (CLIProxy)",
      "enabled": true,
      "environment": [
        {
          "name": "ANTHROPIC_BASE_URL",
          "value": "__CLIPROXY_BASE_URL__"
        },
        {
          "name": "ANTHROPIC_AUTH_TOKEN",
          "value": "__CLIPROXY_API_KEY__",
          "sensitive": true
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "value": ""
        },
        {
          "name": "IS_SANDBOX",
          "value": "1"
        },
        {
          "name": "ENABLE_TOOL_SEARCH",
          "value": "auto"
        }
      ],
      "config": {
        "homePath": "~/.claude-cliproxy",
        "launchArgs": "__CLAUDE_PERMISSION_ARGS__",
        "autoCompactWindow": ""
      }
    },
    "codex-cliproxy": {
      "driver": "codex",
      "displayName": "Codex (CLIProxy)",
      "enabled": true,
      "environment": [
        {
          "name": "CLIPROXY_API_KEY",
          "value": "__CLIPROXY_API_KEY__",
          "sensitive": true
        }
      ],
      "config": {
        "homePath": "~/.codex-t3/cliproxy",
        "launchArgs": ""
      }
    }
  }
}
