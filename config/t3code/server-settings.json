{
  "providers": {
    "codex": {
      "enabled": true
    }
  },
  "providerInstances": {
    "codex-cliproxy": {
      "driver": "codex",
      "displayName": "Codex (CLIProxy)",
      "enabled": true,
      "homePath": "~/.codex-t3/cliproxy",
      "environment": [
        {
          "name": "CLIPROXY_API_KEY",
