{
  "moshi-hook": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "moshi-hook antigravity-hook PreInvocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "moshi-hook antigravity-hook Stop",
        "timeout": 5
      }
    ]
  },
  "traces-share-to-traces": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "$HOME/dotfiles/config/shared/hooks/traces-agent-hook.sh agent-done --agent antigravity >/dev/null 2>&1; printf %s '{\"decision\":\"\"}' # traces hook agent",
        "timeout": 30
      }
    ]
  }
}
