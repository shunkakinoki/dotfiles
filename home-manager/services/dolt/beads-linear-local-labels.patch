  +package main
  +
  +import (
  +	"context"
  +	"reflect"
  +	"testing"
  +
  +	"github.com/steveyegge/beads/internal/tracker"
  +	"github.com/steveyegge/beads/internal/types"
  +)
  +
  +func TestLinearLocalLabelsPullKeepsBeadsOwnedLabels(t *testing.T) {
  +	t.Setenv("LINEAR_LOCAL_LABELS", " Hold, reserved/ ,,agent-plan")
  +	hooks := buildLinearPullHooksForStore(context.Background(), nil, linearPullHookOptions{})
  +	if hooks.AfterConvert == nil {
  +		t.Fatal("AfterConvert is nil with linear.local_labels set")
  +	}
  +
  +	conv := &tracker.IssueConversion{Issue: &types.Issue{Labels: []string{"Bug", "hold", "Refactor"}}}
  +	existing := &types.Issue{Labels: []string{"HOLD", "reserved/lane-a", "agent-plan", "stale-linear"}}
  +	if err := hooks.AfterConvert(context.Background(), &tracker.TrackerIssue{}, conv, "ref", existing, tracker.SyncOptions{}); err != nil {
  +		t.Fatalf("AfterConvert: %v", err)
  +	}
  +
  +	want := []string{"Bug", "Refactor", "HOLD", "reserved/lane-a", "agent-plan"}
  +	if !reflect.DeepEqual(conv.Issue.Labels, want) {
  +		t.Fatalf("labels = %v, want %v", conv.Issue.Labels, want)
  +	}
  +}
  +
  +func TestLinearLocalLabelsPullLeavesCreatesToLinear(t *testing.T) {
  +	t.Setenv("LINEAR_LOCAL_LABELS", "hold")
  +	hooks := buildLinearPullHooksForStore(context.Background(), nil, linearPullHookOptions{})
  +
  +	conv := &tracker.IssueConversion{Issue: &types.Issue{Labels: []string{"Bug", "hold"}}}
  +	if err := hooks.AfterConvert(context.Background(), &tracker.TrackerIssue{}, conv, "ref", nil, tracker.SyncOptions{}); err != nil {
  +		t.Fatalf("AfterConvert: %v", err)
  +	}
  +
  +	if want := []string{"Bug", "hold"}; !reflect.DeepEqual(conv.Issue.Labels, want) {
  +		t.Fatalf("labels = %v, want %v", conv.Issue.Labels, want)
  +	}
  +}
  +
  +func TestLinearLocalLabelsUnsetKeepsLinearLabelSet(t *testing.T) {
  +	t.Setenv("LINEAR_LOCAL_LABELS", "")
  +	hooks := buildLinearPullHooksForStore(context.Background(), nil, linearPullHookOptions{})
  +	if hooks.AfterConvert != nil {
  +		t.Fatal("AfterConvert is set without linear.local_labels")
  +	}
  +}
