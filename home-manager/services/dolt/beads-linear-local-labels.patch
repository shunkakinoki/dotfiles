  +// linearLocalLabels names the labels Beads owns outright. Linear never carries
  +// them, so a pull that took Linear's label set would strip every one of them
  +// from each linked issue and rewrite that issue on every full pull. Entries
  +// ending in "/" match as prefixes; matching ignores case.
  +type linearLocalLabels struct {
  +	names    map[string]struct{}
  +	prefixes []string
  +}
  +
  +func parseLinearLocalLabels(raw string) linearLocalLabels {
  +	owned := linearLocalLabels{names: map[string]struct{}{}}
  +	for _, entry := range strings.Split(raw, ",") {
  +		entry = strings.ToLower(strings.TrimSpace(entry))
  +		switch {
  +		case entry == "":
  +		case strings.HasSuffix(entry, "/"):
  +			owned.prefixes = append(owned.prefixes, entry)
  +		default:
  +			owned.names[entry] = struct{}{}
  +		}
  +	}
  +	return owned
  +}
  +
  +func (o linearLocalLabels) empty() bool {
  +	return len(o.names) == 0 && len(o.prefixes) == 0
  +}
  +
  +func (o linearLocalLabels) owns(label string) bool {
  +	label = strings.ToLower(strings.TrimSpace(label))
  +	if _, ok := o.names[label]; ok {
  +		return true
  +	}
  +	for _, prefix := range o.prefixes {
  +		if strings.HasPrefix(label, prefix) {
  +			return true
  +		}
  +	}
  +	return false
  +}
  +
  +// merge takes the pulled labels Linear owns and the local labels Beads owns,
  +// so a pull neither strips nor adds a Beads-owned label.
  +func (o linearLocalLabels) merge(local, pulled []string) []string {
  +	merged := make([]string, 0, len(local)+len(pulled))
  +	for _, label := range pulled {
  +		if !o.owns(label) {
  +			merged = append(merged, label)
  +		}
  +	}
  +	for _, label := range local {
  +		if o.owns(label) {
  +			merged = append(merged, label)
  +		}
  +	}
  +	return merged
  +}
