{
  "hooks": {
    "afterAgentResponse": [
      {
        "command": "! command -v moshi-hook >/dev/null 2>&1 || moshi-hook cursor-hook"
      }
    ],
    "afterFileEdit": [
      {
        "command": "! command -v moshi-hook >/dev/null 2>&1 || moshi-hook cursor-hook"
      }
    ],
    "afterMCPExecution": [
      {
        "command": "! command -v moshi-hook >/dev/null 2>&1 || moshi-hook cursor-hook"
      }
    ],
    "afterShellExecution": [
      {
        "command": "! command -v moshi-hook >/dev/null 2>&1 || moshi-hook cursor-hook"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "! command -v moshi-hook >/dev/null 2>&1 || moshi-hook cursor-hook"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "! command -v moshi-hook >/dev/null 2>&1 || moshi-hook cursor-hook"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "! command -v moshi-hook >/dev/null 2>&1 || moshi-hook cursor-hook"
      }
    ],
    "sessionEnd": [
      {
        "command": "! command -v moshi-hook >/dev/null 2>&1 || moshi-hook cursor-hook"
      }
