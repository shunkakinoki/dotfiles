+// unchangedDependencyKeys returns the stored edges of sources that a re-add
+// would leave unchanged, keyed like pendingDependencyPreviewKey. A pull
+// re-reads every relation of every issue, and each AddDependency of an edge
+// that already exists still runs a full write transaction, a journal event and
+// a Dolt commit, so a large tracker spends the pull re-writing edges it already
+// has. A re-add replaces metadata with "{}", so only edges already carrying
+// empty metadata are unchanged by it. A failed read leaves the set empty and
+// every edge goes through AddDependency; the warning keeps the prefix the
+// dependency resolution warnings share.
+func (e *Engine) unchangedDependencyKeys(ctx context.Context, sources []string) map[string]struct{} {
+	keys := make(map[string]struct{})
+	if len(sources) == 0 {
+		return keys
+	}
+	reader, err := e.Store.EdgeReader()
+	if err != nil {
+		e.warn("Failed to build dependency resolver: stored edge reader: %v", err)
+		return keys
+	}
+	result, err := reader.ReadEdges(ctx, publicops.EdgeReadRequest{IDs: sources})
+	if err != nil {
+		e.warn("Failed to build dependency resolver: read stored edges: %v", err)
+		return keys
+	}
+	for _, anchor := range result.Anchors {
+		for _, edge := range anchor.Edges {
+			if metadata := strings.TrimSpace(edge.Metadata); metadata != "" && metadata != "{}" {
+				continue
+			}
+			keys[pendingDependencyPreviewKey(anchor.ID, edge.DependsOnID, string(edge.Type))] = struct{}{}
+		}
+	}
+	return keys
+}
