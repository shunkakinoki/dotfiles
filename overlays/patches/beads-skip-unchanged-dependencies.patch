+type addDependencyCountingStore struct {
+	*dolt.DoltStore
+	adds []string
+}
+
+func (s *addDependencyCountingStore) AddDependency(ctx context.Context, dep *types.Dependency, actor string) error {
+	s.adds = append(s.adds, fmt.Sprintf("%s->%s:%s", dep.IssueID, dep.DependsOnID, dep.Type))
+	return s.DoltStore.AddDependency(ctx, dep, actor)
+}
+
+func TestEngineCreateDependenciesSkipsUnchangedEdges(t *testing.T) {
+	ctx := context.Background()
+	base := newTestStore(t)
+	defer base.Close()
+
+	for _, id := range []string{"bd-skip-a", "bd-skip-b", "bd-skip-c"} {
+		issue := &types.Issue{ID: id, Title: id, Status: types.StatusOpen, IssueType: types.TypeTask, Priority: 2}
+		if err := base.CreateIssue(ctx, issue, "test-actor"); err != nil {
+			t.Fatalf("CreateIssue %s: %v", id, err)
+		}
+		if err := base.UpdateIssue(ctx, id, map[string]interface{}{"external_ref": "https://test.test/" + id}, "test-actor"); err != nil {
+			t.Fatalf("UpdateIssue %s external_ref: %v", id, err)
+		}
+	}
+	if err := base.AddDependency(ctx, &types.Dependency{IssueID: "bd-skip-a", DependsOnID: "bd-skip-b", Type: types.DepBlocks}, "test-actor"); err != nil {
+		t.Fatalf("seed a->b: %v", err)
+	}
+	if err := base.AddDependency(ctx, &types.Dependency{IssueID: "bd-skip-c", DependsOnID: "bd-skip-b", Type: types.DepRelated, Metadata: `{"note":"kept"}`}, "test-actor"); err != nil {
+		t.Fatalf("seed c->b: %v", err)
+	}
+
+	store := &addDependencyCountingStore{DoltStore: base}
+	engine := NewEngine(newMockTracker("test"), store, "test-actor")
+	errCount := engine.createDependencies(ctx, []DependencyInfo{
+		{FromExternalID: "https://test.test/bd-skip-a", ToExternalID: "https://test.test/bd-skip-b", Type: string(types.DepBlocks)},
+		{FromExternalID: "https://test.test/bd-skip-a", ToExternalID: "https://test.test/bd-skip-c", Type: string(types.DepBlocks)},
+		{FromExternalID: "https://test.test/bd-skip-a", ToExternalID: "https://test.test/bd-skip-c", Type: string(types.DepBlocks)},
+		{FromExternalID: "https://test.test/bd-skip-c", ToExternalID: "https://test.test/bd-skip-b", Type: string(types.DepRelated)},
+	})
+	if errCount != 0 {
+		t.Fatalf("createDependencies returned errCount=%d, warnings=%v", errCount, engine.warnings)
+	}
+
+	want := []string{
+		"bd-skip-a->bd-skip-c:blocks",
+		"bd-skip-c->bd-skip-b:related",
+	}
+	if strings.Join(store.adds, ",") != strings.Join(want, ",") {
+		t.Fatalf("AddDependency calls = %v, want %v", store.adds, want)
+	}
+
+	records, err := base.GetDependencyRecords(ctx, "bd-skip-a")
+	if err != nil {
+		t.Fatalf("GetDependencyRecords a: %v", err)
+	}
+	var got []string
+	for _, record := range records {
+		got = append(got, fmt.Sprintf("%s:%s", record.DependsOnID, record.Type))
+	}
+	if strings.Join(got, ",") != "bd-skip-b:blocks,bd-skip-c:blocks" {
+		t.Fatalf("a edges = %v, want [bd-skip-b:blocks bd-skip-c:blocks]", got)
+	}
+}
